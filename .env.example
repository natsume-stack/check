# ─── 数据库 ──────────────────────────────────────────
# Vercel Postgres 连接串（部署后在 Vercel 控制台自动注入）
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
POSTGRES_URL="postgresql://user:password@host:5432/db"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/db"

# ─── 加密 ────────────────────────────────────────────
# AES-256-GCM Bootstrap Key（base64，32 字节），与 LokiBox 客户端硬编码一致
BOOTSTRAP_KEY_B64="105DTeoxSkrA76RQSMtyP56CXlzraLK41A1avgw+FnY="
# JWT 签名密钥（生成：openssl rand -base64 48）
JWT_SECRET="change-me-to-a-long-random-string-please-48-bytes-min"
# HMAC 防重放密钥
HMAC_SECRET="change-me-hmac-secret-key"

# ─── 管理员 ──────────────────────────────────────────
# 首次启动 seed 用：admin / cyccodemao1234
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="cyccodemao1234"

# ─── IP 地理定位（可选，留空则用免费端点）─────────────
IPINFO_TOKEN=""
IPAPI_KEY=""

# ─── 应用 ────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="check"
NEXT_PUBLIC_APP_URL="https://check.example.com"
