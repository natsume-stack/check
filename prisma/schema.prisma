// Prisma schema for check system
// Database: TiDB Serverless (MySQL 8.0 compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── 用户 ────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  nickname      String   @default("")
  avatarUrl     String?
  role          Role     @default(USER)
  fingerprint   String?  // 最近一次登录的设备指纹（SHA-256 base64）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime? // 最近心跳时间，用于在线判定

  // 账号状态控制（管理员可操作）
  status        UserStatus @default(ACTIVE)
  bannedAt      DateTime?
  bannedReason  String?
  bannedById    String?   // 执行封禁的管理员 ID
  expiresAt     DateTime? // 账号到期时间，null = 永久

  sessions      Session[]
  loginRecords  LoginRecord[]
  heartbeats    Heartbeat[]
  friendsAsUser Friend[]    @relation("UserFriends")
  friendsAsOther Friend[]   @relation("OtherFriends")
  friendRequestsReceived FriendRequest[] @relation("RequestTo")
  friendRequestsSent     FriendRequest[] @relation("RequestFrom")

  @@index([username])
  @@index([lastSeenAt])
  @@index([status])
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE    // 正常
  BANNED    // 已封禁
  EXPIRED   // 已到期
  SUSPENDED // 已暂停（管理员临时冻结）
}

// ─── 加密会话（LokiBox 兼容）────────────────────────

model Session {
  id           String   @id @default(cuid())
  userId       String?  // 握手时未登录，登录后回填
  sessionKey   String   // base64(32 bytes) — AES-256 key 下发给客户端
  csrfNonce    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedReason String? // BANNED / EXPIRED / LOGOUT / ADMIN_REVOKE / INTEGRITY_FAIL

  // 本次加载的代码包组合哈希（心跳校验完整性）
  codeHash     String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── 登录记录（IP + 位置 + 指纹）────────────────────

model LoginRecord {
  id            String   @id @default(cuid())
  userId        String
  ip            String
  // 地理位置（多源联合定位加权平均后）
  country       String?
  region        String?
  city          String?
  latitude      Float?
  longitude     Float?
  accuracyKm    Float?
  // 网络特征
  asn           String?
  org           String?
  timezone      String?
  // 设备
  fingerprint   String?
  userAgent     String?
  // 元数据
  success       Boolean
  failureReason String?  // BANNED / EXPIRED / WRONG_PASSWORD / SUSPENDED
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ip])
  @@index([createdAt])
}

// ─── 心跳 / Presence ────────────────────────────────

model Heartbeat {
  id           String   @id @default(cuid())
  userId       String
  mapId        String
  playerId     Int?
  // 心跳时上报的代码包哈希，用于完整性校验
  codeHash     String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mapId])
  @@index([createdAt])
}

// ─── 好友 ────────────────────────────────────────────

model Friend {
  id           String   @id @default(cuid())
  userId       String
  otherId      String
  createdAt    DateTime @default(now())

  user  User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  other User @relation("OtherFriends", fields: [otherId], references: [id], onDelete: Cascade)

  @@unique([userId, otherId])
  @@index([userId])
  @@index([otherId])
}

model FriendRequest {
  id           String   @id @default(cuid())
  fromId       String
  toId         String
  createdAt    DateTime @default(now())

  from User @relation("RequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("RequestTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
}

// ─── LokiBox 功能配置（远程控制）─────────────────────

model ProgramConfig {
  id           String   @id @default(cuid())
  // 程序标识，例如 "lokibox"
  programId    String   @default("lokibox")
  // feature id，例如 "kill-aura"，或 "*" 表示全局
  featureId    String
  // JSON 序列化的参数覆盖（与客户端 schema 兼容）
  config       Json
  // 是否强制启用（true 时客户端必须应用且无法关闭）
  enforced     Boolean  @default(false)
  // 是否禁用此 feature（true 时客户端禁用且无法开启）
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([programId, featureId])
  @@index([programId])
}

// ─── 加密代码包（服务端下发）────────────────────────

model CodePackage {
  id           String   @id @default(cuid())
  // feature 标识，例如 "kill-aura", "esp", "fly"
  featureId    String
  // 版本号（语义化版本）
  version      String
  // 代码包（明文 JS 源码，LongText）
  // 字段名保留 encryptedCode 以兼容客户端 schema，实际存储明文
  // 响应时由 encryptedJsonResponse 用 sessionKey 统一加密
  encryptedCode String  @db.LongText
  // 代码包哈希（SHA-256，用于完整性校验）
  codeHash     String
  // 代码包大小（字节，用于统计）
  sizeBytes    Int
  // 是否当前激活版本（同一 featureId 只有一个 active）
  isActive     Boolean  @default(true)
  // 构建信息
  builtAt      DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([featureId, version])
  @@index([featureId])
  @@index([isActive])
}

// ─── 审计日志 ────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String   // BAN / UNBAN / SUSPEND / SET_EXPIRY / UPLOAD_CODE / UPDATE_CONFIG
  target       String?  // 目标用户 ID 或 featureId
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}
