// Prisma schema for check system
// Database: TiDB Serverless (MySQL 8.0 compatible)
//
// 双账户系统：
//   - AdminUser：check 后台账户（admin/代理/普通后台用户）
//   - LokiUser：LokiBox 客户端玩家账户
// 两者彻底分离，防止越权与语义混淆

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── 后台管理员账户（check 网站登录）────────────────

model AdminUser {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  nickname      String   @default("")
  role          Role     @default(USER) // SUPER_ADMIN / AGENT / USER
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime?

  // 安全字段：登录失败计数 + 锁定时间（防暴力破解）
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?

  // 审计日志关联
  auditLogs     AuditLog[]
  // 邀请码关联
  invitationCodes InvitationCode[] @relation("InvitationCreator")

  @@index([username])
}

enum Role {
  SUPER_ADMIN // 超级管理员：全量开放
  AGENT       // 代理：可管理 LokiUser，不能看程序管理
  USER        // 普通后台用户：只能看仪表盘
}

// ─── LokiBox 客户端玩家账户（加密链路登录）──────────

model LokiUser {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  nickname      String   @default("")
  avatarUrl     String?
  fingerprint   String?  // 最近一次登录的设备指纹（SHA-256 base64）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime? // 最近心跳时间，用于在线判定

  // 账号状态控制（管理员可操作）
  status        LokiUserStatus @default(ACTIVE)
  bannedAt      DateTime?
  bannedReason  String?
  bannedById    String?   // 执行封禁的 AdminUser ID
  expiresAt     DateTime? // 账号到期时间，null = 永久

  // 安全字段：登录失败计数 + 锁定时间
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?

  sessions      Session[]
  loginRecords  LoginRecord[]
  heartbeats    Heartbeat[]
  friendsAsUser Friend[]    @relation("UserFriends")
  friendsAsOther Friend[]   @relation("OtherFriends")
  friendRequestsReceived FriendRequest[] @relation("RequestTo")
  friendRequestsSent     FriendRequest[] @relation("RequestFrom")

  @@index([username])
  @@index([lastSeenAt])
  @@index([status])
}

enum LokiUserStatus {
  ACTIVE    // 正常
  BANNED    // 已封禁
  EXPIRED   // 已到期
  SUSPENDED // 已暂停（管理员临时冻结）
}

// ─── 加密会话（LokiBox 兼容）────────────────────────

model Session {
  id           String   @id @default(cuid())
  userId       String?  // 握手时未登录，登录后回填（LokiUser.id）
  sessionKey   String   // base64(32 bytes) — AES-256 key 下发给客户端
  csrfNonce    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedReason String? // BANNED / EXPIRED / LOGOUT / ADMIN_REVOKE / INTEGRITY_FAIL

  // 本次加载的代码包组合哈希（心跳校验完整性）
  codeHash     String?
  licenseNonce  String?  // 当前 license nonce（心跳续期用）

  user LokiUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── 登录记录（IP + 位置 + 指纹）────────────────────

model LoginRecord {
  id            String   @id @default(cuid())
  userId        String
  ip            String
  // 地理位置（多源联合定位加权平均后）
  country       String?
  region        String?
  city          String?
  latitude      Float?
  longitude     Float?
  accuracyKm    Float?
  // 网络特征
  asn           String?
  org           String?
  timezone      String?
  // 设备
  fingerprint   String?
  userAgent     String?
  // 元数据
  success       Boolean
  failureReason String?  // BANNED / EXPIRED / WRONG_PASSWORD / SUSPENDED / LOCKED
  createdAt     DateTime @default(now())

  user LokiUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ip])
  @@index([createdAt])
}

// ─── 心跳 / Presence ────────────────────────────────

model Heartbeat {
  id           String   @id @default(cuid())
  userId       String
  mapId        String
  playerId     Int?
  // 心跳时上报的代码包哈希，用于完整性校验
  codeHash     String?
  createdAt    DateTime @default(now())

  user LokiUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mapId])
  @@index([createdAt])
}

// ─── 好友 ────────────────────────────────────────────

model Friend {
  id           String   @id @default(cuid())
  userId       String
  otherId      String
  createdAt    DateTime @default(now())

  user  LokiUser @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  other LokiUser @relation("OtherFriends", fields: [otherId], references: [id], onDelete: Cascade)

  @@unique([userId, otherId])
  @@index([userId])
  @@index([otherId])
}

model FriendRequest {
  id           String   @id @default(cuid())
  fromId       String
  toId         String
  createdAt    DateTime @default(now())

  from LokiUser @relation("RequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   LokiUser @relation("RequestTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
}

// ─── LokiBox 功能配置（远程控制）─────────────────────

model ProgramConfig {
  id           String   @id @default(cuid())
  // 程序标识，例如 "lokibox"
  programId    String   @default("lokibox")
  // feature id，例如 "kill-aura"，或 "*" 表示全局
  featureId    String
  // JSON 序列化的参数覆盖（与客户端 schema 兼容）
  config       Json
  // 是否强制启用（true 时客户端必须应用且无法关闭）
  enforced     Boolean  @default(false)
  // 是否禁用此 feature（true 时客户端禁用且无法开启）
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([programId, featureId])
  @@index([programId])
}

// ─── 加密代码包（服务端下发）────────────────────────

model CodePackage {
  id           String   @id @default(cuid())
  // feature 标识，"lokibox-pack" 表示完整代码包
  featureId    String
  // 版本号（构建时间戳）
  version      String
  // 代码包（明文 JS 源码，LongText）
  // 响应时由 encryptedJsonResponse 用 sessionKey 统一加密
  encryptedCode String  @db.LongText
  // 代码包哈希（SHA-256，用于完整性校验）
  codeHash     String
  // HMAC 签名（防篡改，客户端可校验）
  hmacSignature String
  // 代码包大小（字节，用于统计）
  sizeBytes    Int
  // 是否当前激活版本（同一 featureId 只有一个 active）
  isActive     Boolean  @default(true)
  // 构建信息
  builtAt      DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([featureId, version])
  @@index([featureId])
  @@index([isActive])
}

// ─── 审计日志 ────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?  // AdminUser.id
  action       String   // BAN / UNBAN / SUSPEND / SET_EXPIRY / UPLOAD_CODE / UPDATE_CONFIG / CREATE_ADMIN / CHANGE_ROLE
  target       String?  // 目标用户 ID 或 featureId
  meta         Json?
  createdAt    DateTime @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

// ─── 限流计数桶（DB 持久化，跨 Serverless 实例共享）──

model RateLimitBucket {
  id           String   @id @default(cuid())
  bucketKey    String   // 格式：{action}:{ip}，如 "loki-login:1.2.3.4"
  count        Int      @default(1)
  windowStart  DateTime @default(now())
  expiresAt    DateTime

  @@unique([bucketKey])
  @@index([expiresAt])
}

// ─── Nonce 防重放（DB 持久化，跨 Serverless 实例共享）──

model UsedNonce {
  nonce       String   @id  // X-Nonce 头的值（UUID）
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ─── 系统配置（全局开关 / 键值对）────────────────────

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique // 配置键，如 "pack_distribution_disabled"
  value     String   @default("false") // 配置值，"true" / "false"
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ─── 邀请码（注册控制）──────────────────────────────

model InvitationCode {
  id           String    @id @default(cuid())
  code         String    @unique // 邀请码（32 字符 base62）
  targetType   String    @default("LOKI") // "LOKI" = LokiUser 客户端, "ADMIN" = AdminUser 后台
  maxUses      Int       @default(1) // 最大使用次数（1=单次使用）
  usedCount    Int       @default(0) // 已使用次数
  usedById     String?   // 使用者 ID（AdminUser.id 或 LokiUser.id）
  usedAt       DateTime? // 使用时间
  createdById  String?   // 创建者 AdminUser ID
  createdAt    DateTime  @default(now())
  expiresAt    DateTime? // 过期时间，null=永久
  disabledAt   DateTime? // 禁用时间，null=启用中

  // 关联创建者
  createdBy    AdminUser? @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([createdById])
  @@index([targetType])
}

// ─── 设备黑名单（封禁连坐）──────────────────────────

model DeviceBlacklist {
  id           String   @id @default(cuid())
  fingerprint  String?  // 设备指纹（SHA-256 base64）
  ip           String?  // IP 地址
  reason       String   // 封禁原因
  bannedUserId String?  // 被封禁的用户 ID
  bannedById   String?  // 执行封禁的 AdminUser ID
  createdAt    DateTime @default(now())

  @@index([fingerprint])
  @@index([ip])
}
